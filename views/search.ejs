<!-- search.ejs -->
<!DOCTYPE html>
<html lang="en">
<head><%- include("partials/head", { pageTitle: q ? `"${q}"` : "Search" }) %></head>
<body>

<div class="app-layout">
  <%- include("partials/sidebar", { activePage: "search" }) %>

  <div class="main-area">

    <header class="topbar">
      <div class="topbar-left">
        <h1 class="topbar-greeting">Search</h1>
      </div>

      <div class="topbar-right <%= !q ? 'is-hidden' : '' %>">
        <form class="search-bar-wrap" action="/search" method="GET">
          <span class="search-bar-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </span>
          <input class="search-bar-input" id="searchInput" name="q" type="text" value="<%= q %>" placeholder="Songs, artists, albums…" autocomplete="off" autofocus />          <div class="search-dropdown" id="searchDropdown"></div>
        </form>
      </div>
    </header>

    <main class="page-content">

      <% if (!q) { %>
        <!-- centered empty search -->
        <div class="search-empty search-empty-centered">
          <div class="search-empty-icon">🎵</div>
          <h2>Search for music</h2>
          <p>Find songs, artists, or albums.</p>

          <form class="search-empty-form" action="/search" method="GET">
            <span class="search-bar-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </span>
            <input class="search-bar-input search-empty-input" name="q" type="text" placeholder="Search Wavify" autocomplete="off" autofocus />
          </form>
        </div>
      <% } else if (songs.length === 0) { %>

        <div class="search-empty">
          <div class="search-empty-icon">😕</div>
          <p>No songs found for "<%= q %>"</p>
          <div class="text-muted">Try a different search</div>
        </div>

      <% } else { %>

        <section class="grid-section">
          <div class="section-header">
            <h2 class="section-title">Results for "<%= q %>"</h2>
            <span class="text-muted"><%= songs.length %> songs</span>
          </div>

          <div class="song-grid">
            <% songs.forEach((song) => { %>
              <%- include("partials/song-card", { song, queueGroup: "search-results" }) %>
            <% }) %>
          </div>
        </section>

      <% } %>

    </main>
  </div>
</div>

<%- include("partials/playlist-picker", { playlists }) %>
<%- include("partials/player") %>

<script src="/app.js"></script>
<script>
  initPage();
</script>
</body>
</html>