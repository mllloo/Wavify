<!DOCTYPE html>
<html lang="en">
<head><%- include("partials/head", { pageTitle: "Recently Played" }) %></head>
<body>

<div class="app-layout">
  <%- include("partials/sidebar", { activePage: "recent" }) %>

  <div class="main-area">
    <header class="topbar">
      <div class="topbar-left">
        <a href="/" class="topbar-back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        </a>
        <h1 class="topbar-greeting">Recently Played</h1>
      </div>
      <div class="topbar-right">
        <div class="search-bar-wrap">
          <span class="search-bar-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </span>
          <input class="search-bar-input" id="searchInput" type="text" placeholder="Songs, artists, albums…" autocomplete="off" />
          <div class="search-dropdown" id="searchDropdown"></div>
        </div>
      </div>
    </header>

    <main class="page-content">
      <div class="playlist-hero liked-hero">
        <div class="liked-hero-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="white"><path d="M13 3a9 9 0 1 0 8.95 10h-2.02A7 7 0 1 1 13 5v4l5-5-5-5v4z"/></svg>
        </div>
        <div class="playlist-hero-info">
          <p class="playlist-type">Auto playlist</p>
          <h2 class="playlist-hero-name">Recently Played</h2>
          <p class="playlist-count-text" id="recent-count-text">0 songs</p>
          <button class="btn-play-all" id="btn-play-recent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
            Play All
          </button>
        </div>
      </div>

      <div class="playlist-track-list" id="recent-track-list">
        <div class="search-empty" id="recent-empty" style="display:none">
          <div class="search-empty-icon">⏱️</div>
          <p>No recent songs yet</p>
          <p class="text-muted">Play a song to see it here</p>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include("partials/player") %>
<script src="/app.js"></script>
<script>
  initPage();

  function renderRecentPage() {
    const list = document.getElementById('recent-track-list');
    const empty = document.getElementById('recent-empty');
    const countEl = document.getElementById('recent-count-text');
    const songs = S.recent;

    countEl.textContent = songs.length + ' song' + (songs.length !== 1 ? 's' : '');

    list.querySelectorAll('.playlist-track').forEach(el => el.remove());

    if (!songs.length) {
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';

    songs.forEach((song, i) => {
      const div = document.createElement('div');
      div.className = 'playlist-track';
      div.dataset.name = song.name || '';
      div.dataset.artist = song.artist || '';
      div.dataset.audio = song.audio || '';
      div.dataset.image = song.image || '';
      div.dataset.queueGroup = 'recent-page';

      div.innerHTML = `
        <span class="track-num">${i + 1}</span>
        <img class="track-img" src="${song.image || ''}" alt="" />
        <div class="track-info">
          <p class="track-name">${escHtml(song.name)}</p>
          <p class="track-artist">${escHtml(song.artist)}</p>
        </div>
        <div class="track-actions track-actions-liked">
          <button class="song-card-like" data-name="${escHtml(song.name)}" data-artist="${escHtml(song.artist)}" data-audio="${song.audio || ''}" data-image="${song.image || ''}" title="Add to Liked Songs">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </button>
        </div>
      `;

      div.addEventListener('click', e => {
        if (e.target.closest('.track-actions')) return;
        playSongWithQueue(song, songs, i);
      });

      div.querySelector('.song-card-like').addEventListener('click', e => {
        e.stopPropagation();
        toggleFavorite(song);
        renderRecentPage();
      });

      list.appendChild(div);
    });

    initSongCards();
  }

  document.getElementById('btn-play-recent').addEventListener('click', () => {
    if (!S.recent.length) return;
    playSongWithQueue(S.recent[0], S.recent, 0);
  });

  renderRecentPage();
</script>
</body>
</html>