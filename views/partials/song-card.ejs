<article
  class="song-card"
  data-name="<%= song.name || '' %>"
  data-artist="<%= song.artist || '' %>"
  data-audio="<%= song.audio || '' %>"
  data-image="<%= song.image || '' %>"
  data-queue-group="<%= queueGroup || '' %>"
>
  <button
    class="song-card-like"
    data-name="<%= song.name || '' %>"
    data-artist="<%= song.artist || '' %>"
    data-audio="<%= song.audio || '' %>"
    data-image="<%= song.image || '' %>"
    aria-label="Like"
    title="Add to Liked Songs"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
  </button>

  <button class="song-card-add" aria-label="Add to playlist" title="Add to playlist">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
    </svg>
  </button>

  <div class="song-card-img-wrap">
    <img src="<%= song.image || '' %>" alt="<%= song.name || '' %>" />

    <div class="song-card-play-overlay">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="white">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>
  </div>

  <div class="song-card-body">
    <div class="song-card-name"><%= song.name || '' %></div>
    <div class="song-card-artist"><%= song.artist || '' %></div>
  </div>
</article>