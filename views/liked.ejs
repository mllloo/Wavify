<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { pageTitle: "Liked Songs" }) %>
</head>
<body>

<div class="app-layout">
  <%- include("partials/sidebar", { activePage: "liked" }) %>

  <div class="main-area">

    <header class="topbar">
      <div class="topbar-left">
        <a href="/" class="topbar-back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
        </a>
        <h1 class="topbar-greeting">Liked Songs</h1>
      </div>

      <div class="topbar-right"></div>
    </header>

    <main class="page-content">

      <!-- HERO -->
      <div class="playlist-hero liked-hero">
        <div class="liked-hero-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="white">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>

        <div class="playlist-hero-info">
          <p class="playlist-type">Auto playlist</p>
          <h2 class="playlist-hero-name">Liked Songs</h2>
          <p class="playlist-count-text" id="liked-count-text">0 songs</p>

          <button class="btn-play-all" id="btn-play-liked">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white">
              <path d="M8 5v14l11-7z"/>
            </svg>
            Play All
          </button>
        </div>
      </div>

      <!-- LIST -->
      <div class="playlist-track-list" id="liked-track-list">

        <div class="search-empty" id="liked-empty" style="display:none">
          <div class="search-empty-icon">🤍</div>
          <p>No liked songs yet</p>
          <p class="text-muted">Click the heart on any song to add it here</p>
        </div>

      </div>

    </main>
  </div>
</div>

<%- include("partials/player") %>
<script src="/app.js"></script>

<script id="liked-data" type="application/json">
  <%- JSON.stringify(songs || []) %>
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  // IMPORTANT: reuse global system
  S.queue = S.queue || [];

  const favs = JSON.parse(
    document.getElementById("liked-data").textContent || "[]"
  );

  // sync global state
  S.favorites = favs;

  const list  = document.getElementById('liked-track-list');
  const empty = document.getElementById('liked-empty');
  const count = document.getElementById('liked-count-text');

  function renderLiked() {

    count.textContent = `${S.favorites.length} song${S.favorites.length !== 1 ? 's' : ''}`;

    list.querySelectorAll('.playlist-track').forEach(el => el.remove());

    if (!S.favorites.length) {
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';

    S.favorites.forEach((song, i) => {

      const row = document.createElement('div');
      row.className = 'playlist-track';

      row.dataset.name = song.name || '';
      row.dataset.artist = song.artist || '';
      row.dataset.audio = song.audio || '';
      row.dataset.image = song.image || '';
      row.dataset.queueGroup = "liked";

      row.innerHTML = `
        <span class="track-num">${i + 1}</span>

        <img class="track-img" src="${song.image || ''}" />

        <div class="track-info">
          <p class="track-name">${song.name || ''}</p>
          <p class="track-artist">${song.artist || ''}</p>
        </div>

        <!-- SAME HEART STYLE AS OTHER PAGE -->
        <div class="track-actions">
          <button class="song-card-like liked"
            data-name="${song.name || ''}"
            data-artist="${song.artist || ''}"
            data-audio="${song.audio || ''}"
            data-image="${song.image || ''}"
            title="Remove from Liked">
            
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>

          </button>
        </div>
      `;

      // play row
      row.addEventListener('click', e => {
        if (e.target.closest('.track-actions')) return;

        const idx = Array.from(list.querySelectorAll('.playlist-track')).indexOf(row);

        playSongWithQueue(song, S.favorites, idx);
      });

      // HEART CLICK (IMPORTANT PART)
      row.querySelector('.song-card-like').addEventListener('click', async (e) => {
        e.stopPropagation();

        await toggleFavorite(song);

        // update local state instantly
        S.favorites = S.favorites.filter(f => f.audio !== song.audio);

        renderLiked();

        // sync other UI hearts globally
        _syncLikeButtons();
        _syncLikedCount();
      });

      list.appendChild(row);
    });
  }

  document.getElementById('btn-play-liked')?.addEventListener('click', () => {
    if (!S.favorites.length) return;
    playSongWithQueue(S.favorites[0], S.favorites, 0);
  });

  renderLiked();
});
</script>

</body>
</html>